{
  "name": "zivon",
  "private": true,
  "version": "0.1.0",
  "description": "Zivon - a voice-first Physics tutor with a static lesson content factory.",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:server": "node server.js",
    "start": "node server.js",
    "build": "npm run build --workspace=web",
    "lint": "npm run lint --workspace=web && node --check server.js",
    "preview": "npm run preview --workspace=web"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  }
}
